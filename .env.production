# Used by `npm run build` (the files you upload).
# The API, on its own host.
VITE_API_URL=https://api.3rbyty.com

# Shown on the help page and in the terms when the API sends no support details.
VITE_SUPPORT_EMAIL=support@3rbyty.com

# Google sign-in: the web OAuth client id (public). Empty hides the button.
VITE_GOOGLE_CLIENT_ID=186187478818-0hdqnb438l3dv16mb6q8a86rsp3ditvt.apps.googleusercontent.com

# The website's own address, no trailing slash: share previews (og:image) and robots.txt.
VITE_SITE_URL=https://3rbyty.com
