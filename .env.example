# development | test | production
NODE_ENV=development
PORT=3000

# MongoDB connection string (Atlas or local).
MONGO_URI=mongodb://127.0.0.1:27017/arabity

# Signing keys: random strings of at least 32 characters, all different.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_RESET_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
# Session length in days; "remember me" keeps the longer one.
REFRESH_TOKEN_DAYS=7
REFRESH_TOKEN_REMEMBER_DAYS=30

OTP_EXPIRES_MINUTES=5
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Comma-separated browser origins (the mobile app does not need one).
CORS_ORIGINS=

# The admin dashboard. Without ADMIN_JWT_SECRET (another random string,
# different from the two above) /api/v1/admin is not served. Admins are made
# with: npm run admin:create, or listed in ADMIN_ACCOUNTS below.
ADMIN_JWT_SECRET=
ADMIN_TOKEN_HOURS=8
# Comma-separated addresses of the dashboard, e.g. https://admin.3arabity.com
ADMIN_ORIGINS=
# The admins, as one line of JSON, made or brought up to date on every start:
# a changed password or role takes effect (and signs that admin out), and
# admins left out of the list stay as they are. Role: OWNER or MODERATOR;
# passwords 8 characters or more. Keep this file out of git.
# ADMIN_ACCOUNTS='[{"email":"you@example.com","name":"Your Name","role":"OWNER","password":"change-me-please"}]'
ADMIN_ACCOUNTS=

# Number of proxies in front of the API (for per-client rate limits), or false.
TRUST_PROXY=false

# Folder for uploaded profile photos, served under /uploads.
UPLOADS_DIR=uploads

# SMTP for OTP emails. Leave MAIL_HOST empty in development to print codes
# to the console instead of sending them.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM="عربيتي <follow@3rbyty.com>"

# Google sign-in: the OAuth client ids (from the Firebase config files) whose
# ID tokens are accepted, comma separated. Empty turns Google sign-in off.
GOOGLE_CLIENT_IDS=

# Push notifications: path to the Firebase service account key file
# (Firebase console > Project settings > Service accounts). Keep the file out
# of git. Empty logs pushes instead of sending them.
FIREBASE_SERVICE_ACCOUNT_FILE=
# Or the key itself, as one line of JSON (handy on hosts with no files);
# it wins over the file. Keep it out of git.
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"…","private_key":"…","client_email":"…"}'
FIREBASE_SERVICE_ACCOUNT=

# Support contact the app shows; when all three are set they win over the dashboard's.
# All three or none; phones like 01001234567 or +201001234567.
SUPPORT_EMAIL=
SUPPORT_PHONE=
SUPPORT_WHATSAPP=

# The website, e.g. https://3rbyty.com. Serves /sitemap.xml (its parts and
# shops) for search engines; empty: none.
SITE_URL=
