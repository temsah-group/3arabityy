# Where `npm run dev` forwards /api and /uploads (the backend).
API_PROXY_TARGET=http://localhost:3000

# Production only, when the site and the API are on different hosts:
# the API host, e.g. https://api.3rbyty.com (a trailing /api/v1 is fine too).
# Leave empty when both sit behind one domain. Goes in .env.production.
VITE_API_URL=

# Shown on the help page and in the terms when the API sends no support details.
VITE_SUPPORT_EMAIL=

# Google sign-in: the web OAuth client id (public). Empty hides the button.
VITE_GOOGLE_CLIENT_ID=

# The website's own address, no trailing slash: share previews (og:image) and robots.txt.
VITE_SITE_URL=
