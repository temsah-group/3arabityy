# The API, including /api/v1. Leave unset in development: Vite forwards
# /api and /uploads to http://localhost:3000 (or API_TARGET).
VITE_API_URL=

# Google Maps Embed key for the map on each shop's page, restricted in Google
# Cloud to the dashboard's sites (http://localhost:5173/* and the live one).
# Without it the page shows only a link to Google Maps.
VITE_MAPS_EMBED_KEY=
